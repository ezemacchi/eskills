{
  "pack": {
    "name": "example",
    "description": "An invented project: Jira Cloud, Bitbucket Server, Jenkins, Teams and specification files in a git repository, with no cd provider. Only values: no scripts."
  },
  "kit": {
    "name": "example-skills",
    "lint": {
      "allow": ["setup/defaults/*", "setup/pack/*"],
      "patterns": [
        { "name": "URL", "regex": "https?://[A-Za-z0-9-]+\\.[A-Za-z]" },
        { "name": "absolute Windows path", "regex": "\\b[A-Za-z]:[\\\\/]" },
        { "name": "GUID", "regex": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" },
        { "name": "Jira custom field id", "regex": "customfield_\\d+" },
        { "name": "company e-mail", "regex": "@acme\\.invalid" },
        { "name": "project key", "regex": "\\bEXA\\b" }
      ]
    }
  },
  "capabilities": {
    "board": { "provider": "jira-cloud" },
    "repo": { "provider": "bitbucket-server" },
    "ci": { "provider": "jenkins" },
    "cd": { "provider": "", "enabled": false },
    "chat": { "provider": "teams" },
    "specs": { "provider": "git-files" }
  },
  "user": {
    "language": "en"
  },
  "repos": [
    {
      "path": "paths.codeRepo",
      "name": "app",
      "cloneUrl": "https://git.acme.invalid/scm/exa/app.git",
      "uses": "the pull-request sections"
    },
    {
      "path": "paths.specsRepo",
      "name": "app-specs",
      "cloneUrl": "https://git.acme.invalid/scm/exa/app-specs.git",
      "uses": "story specification files",
      "capability": "specs"
    }
  ],
  "board": {
    "testIssueType": "Test"
  },
  "brief": {
    "followLinks": ["Relates"]
  },
  "providers": {
    "jira-cloud": {
      "site": "https://example.atlassian.net",
      "apiBase": "https://example.atlassian.net",
      "project": "EXA",
      "board": 12,
      "fields": {}
    },
    "jenkins": {
      "root": "https://ci.acme.invalid",
      "multibranch": "https://ci.acme.invalid/job/app",
      "blueOceanPipeline": "app",
      "jobs": {
        "release": "https://ci.acme.invalid/job/app-release"
      }
    },
    "bitbucket-server": {
      "base": "https://git.acme.invalid",
      "project": "EXA",
      "repo": "app",
      "sonarReportKey": "",
      "qualityName": ""
    },
    "teams": {
      "tenantId": "00000000-0000-0000-0000-000000000000"
    },
    "git-files": {
      "branch": "main",
      "root": "docs/specs",
      "codePattern": "(?i)\\b(?<project>EXA)-(?<num>\\d+)\\b",
      "codeHelp": "a ticket key like EXA-42",
      "upper": ["project"],
      "folderTemplate": "{root}/",
      "fileTemplate": "{project}-{num}-"
    }
  }
}
